{
  "name": "@navels/neal",
  "version": "0.4.1",
  "description": "A source-first multi-agent CLI for planning, executing, reviewing, and resuming scoped code changes.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Lee Nave",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "homepage": "https://github.com/navels/neal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navels/neal.git"
  },
  "bugs": {
    "url": "https://github.com/navels/neal/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "codex",
    "claude",
    "code-review",
    "multi-agent",
    "planning",
    "refactoring"
  ],
  "bin": {
    "neal": "dist/neal/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "neal.yml",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "build": "rm -rf dist && node node_modules/typescript-7/bin/tsc -p tsconfig.json && chmod +x dist/neal/index.js",
    "pack:local": "pnpm build && pnpm pack",
    "verify:package": "pnpm build && node scripts/verify-package.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "dev:link": "pnpm build && npm link",
    "lint": "eslint src test",
    "start": "tsx src/neal/index.ts",
    "test": "NEAL_NOTIFY_BIN= node --import tsx --test test/*.test.ts",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript-7/bin/tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.30",
    "@anthropic-ai/claude-agent-sdk": "0.3.235",
    "@openai/codex-sdk": "0.148.0",
    "ai": "7.0.65",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
